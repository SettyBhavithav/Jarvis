# ====================================================================
# JARVIS V2 - ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or credentials to Git!
# ====================================================================

# --- Cloud AI Neural Providers ---
GROQ_API_KEY=your_groq_api_key_here
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_QWEN_API_KEY=your_nim_qwen_key_here
NIM_GEMMA_API_KEY=your_nim_gemma_key_here
NIM_VISION_API_KEY=your_nim_vision_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- Supabase PostgreSQL + pgvector Persistence ---
SUPABASE_URL=https://your-project.supabase.co
# Standard client/anon key used for authenticated user requests
SUPABASE_KEY=your_supabase_anon_public_key_here

# WARNING: SERVER-SIDE / TEST ADMIN ONLY!
# NEVER expose client-side. NEVER commit to Git.
# Used exclusively for server-side administrative tasks and automated integration test provisioning.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- Discord OpenClaw Remote Interface ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Whitelist authorized Discord user IDs (JSON list format) to restrict PC execution
DISCORD_ALLOWED_USER_IDS=[123456789012345678]

# --- Security & Policy Settings ---
REQUIRE_CONFIRMATION_FOR_LEVEL_3=true
REQUIRE_CONFIRMATION_FOR_LEVEL_4=true
ENABLE_LLAMA_GUARD=true

